# Variables d'environnement SERVEUR pour la connexion Google Sheets
# (effectifs ÉQUIPES / MEMBRES). À définir dans Vercel → Settings →
# Environment Variables, JAMAIS dans ce fichier ni commitées.
#
# Aucune de ces variables ne doit porter le préfixe VITE_ : ce préfixe
# ferait automatiquement passer sa valeur dans le bundle envoyé au
# navigateur. Ces variables ne sont lues que par les fonctions sous api/.
#
# Guide complet de configuration : docs/roster-google-sheets.md

# ID du Google Sheet (dans son URL, entre /d/ et /edit).
GOOGLE_SHEET_ID=1_exemple_faux_identifiant_de_feuille_0000000

# Adresse courriel du compte de service Google Cloud, avec le rôle
# Lecteur UNIQUEMENT sur ce Sheet précis (jamais sur tout le Drive).
GOOGLE_SERVICE_ACCOUNT_EMAIL=alerions-roster-lecture@exemple-projet.iam.gserviceaccount.com

# Clé privée du compte de service (format PEM, clé du fichier JSON
# téléchargé depuis Google Cloud). Les retours à la ligne réels ou
# littéraux ("\n") sont tous deux acceptés — normalisés automatiquement
# par api/_lib/sheets.ts.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nFAUSSE_VALEUR_EXEMPLE_A_REMPLACER\n-----END PRIVATE KEY-----\n"

# Durée (secondes) pendant laquelle une lecture Google Sheets est
# réutilisée avant d'en redemander une nouvelle. 30 par défaut.
ALERIONS_ROSTER_CACHE_SECONDS=30

# Facultatif — liste blanche (séparée par des virgules) des noms d'hôtes
# HTTPS autorisés pour une photo_url publique. Laisser absent accepte tout
# hôte HTTPS (limite documentée dans docs/roster-google-sheets.md) tant
# qu'aucun proxy d'image n'est en place.
# ALERIONS_PHOTO_HOST_ALLOWLIST=drive.google.com,lh3.googleusercontent.com
